# Copy to /etc/systemd/system/ytdlp-web.service, adjust User and paths, then:
#   sudo systemctl daemon-reload && sudo systemctl enable --now ytdlp-web
[Unit]
Description=yt-dlp web UI
After=network-online.target
Wants=network-online.target

[Service]
User=YOUR_USER
WorkingDirectory=/opt/ytdlp-web
Environment=HOST=127.0.0.1
Environment=PORT=8080
Environment=DOWNLOAD_DIR=/opt/ytdlp-web/downloads
ExecStart=/opt/ytdlp-web/run.sh
Restart=on-failure

[Install]
WantedBy=multi-user.target
