# Copy to .env and edit. Lines starting with # are ignored.

# 127.0.0.1 = only this machine. 0.0.0.0 = reachable from your network (LAN, ZeroTier).
HOST=127.0.0.1
PORT=8080

# Where downloads are stored (default: ./downloads)
#DOWNLOAD_DIR=/home/you/ytdlp-downloads

# Downloads running at once; the rest queue
#MAX_CONCURRENT=2

# Delete downloads this many hours after they were saved (0 = keep forever)
#RETENTION_HOURS=24

# Always keep this much disk space free (0 = no limit)
#MIN_FREE_GB=5
