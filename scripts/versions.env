# Pinned versions of the bundled runtime. Bump these and re-run scripts/setup.sh.
# Python: https://github.com/astral-sh/python-build-standalone/releases
PYTHON_VERSION=3.13.15
PYTHON_BUILD_TAG=20260924
# Deno (JS runtime yt-dlp uses for YouTube challenges): https://github.com/denoland/deno/releases
DENO_VERSION=v2.9.7
# ffmpeg: yt-dlp's patched builds, https://github.com/yt-dlp/FFmpeg-Builds/releases
# "latest" tracks their rolling release; set a dated tag (e.g. autobuild-2026-09-28-...) to pin.
FFMPEG_BUILD_TAG=latest
